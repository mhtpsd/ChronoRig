# Core Application
ENVIRONMENT=development
APP_NAME=chronorig-api
LOG_LEVEL=INFO

# PostgreSQL (via PgBouncer on 6432 in prod, 5432 in local dev)
DATABASE_ASYNC_URL=postgresql+asyncpg://chronorig:chronorig_dev_pwd@localhost:5432/chronorig
DATABASE_SYNC_URL=postgresql+psycopg://chronorig:chronorig_dev_pwd@localhost:5432/chronorig

# Redis (Broker + Pub/Sub + Rate Limiter)
REDIS_URL=redis://localhost:6379/0

# Meta Model API (Optional / Supported - https://dev.meta.ai)
META_MODEL_API_KEY=meta_sk_replace_with_your_actual_key_minimum_20_chars
META_MODEL_BASE_URL=https://api.meta.ai/v1
SAM_MODEL_ID=sam-3.1
MUSE_SPARK_MODEL_ID=muse-spark-1.3
MUSE_IMAGE_MODEL_ID=muse-image-1.0

# Open-Weight Inference (Baseten credits or Modal GPU credits)
BASETEN_API_KEY=replace_with_baseten_api_key_min_20_chars
BASETEN_BASE_URL=https://inference.baseten.co/v1
MODAL_API_KEY=
MODAL_BASE_URL=
MUSE_SPARK_OPEN_MODEL_ID=meta-models/muse-spark-open-1026

# Security & Object Storage
JWT_SECRET_KEY=replace_with_32_byte_hex_secret_from_openssl_rand_hex_32
CORS_ORIGINS=["http://localhost:3000"]
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=chronorig-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Frontend Public Vars
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
